<div class="drawer" data-drawer hidden>
  <button class="backdrop" type="button" data-close-bag aria-label="Close bag"></button>
  <aside class="glass-strong sheet" role="dialog" aria-label="Your bag">
    <div class="sheet-head">
      <h2 class="display">Your bag</h2>
      <button class="icon-btn" type="button" data-close-bag aria-label="Close">×</button>
    </div>
    <div class="sheet-body" data-bag-lines></div>
    <div class="sheet-foot">
      <div class="total-row">
        <span>Total</span>
        <strong class="display" data-bag-total>Rs 0</strong>
      </div>
      <p class="muted" data-ship-note></p>
      <button class="btn full" type="button" data-wa-order>Send order on WhatsApp</button>
      <button class="btn line full" type="button" data-clear-bag>Clear bag</button>
    </div>
  </aside>
</div>

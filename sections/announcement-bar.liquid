{% if section.blocks.size > 0 %}
  <div class="marquee" style="background: var(--fjord); color: var(--mist);">
    <div class="marquee-track">
      {% for copy in (1..2) %}
        <div class="marquee-group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
          {% for repeat in (1..8) %}
            {% for block in section.blocks %}
              <span{% if copy == 1 and repeat == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}<span class="dot">·</span></span>
            {% endfor %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "❄️  Winter sale is live now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "🚚  Free shipping over Rs 3,000" } },
        { "type": "message", "settings": { "text": "❄️  Winter sale is live now" } }
      ]
    }
  ]
}
{% endschema %}

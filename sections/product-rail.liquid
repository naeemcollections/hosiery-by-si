<section id="{{ section.settings.anchor }}" class="rail">
  <div class="section-head">
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h2 class="display">{{ section.settings.heading }}</h2>
    <p class="muted">{{ section.settings.copy }}</p>
  </div>
  <div class="{% if section.settings.layout == 'grid' %}grid{% else %}scroller{% endif %}">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% assign rupees = product.price | divided_by: 100 %}
        {% assign was = product.compare_at_price | divided_by: 100 %}
        {% capture img %}{{ product.featured_image | image_url: width: 900 }}{% endcapture %}
        {% render 'card',
          id: product.id,
          title: product.title,
          price: rupees,
          compare: was,
          blurb: product.description | strip_html | truncate: 120,
          image: img,
          badge: ''
        %}
      {% endfor %}
    {% else %}
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          {% capture img %}{{ block.settings.image | image_url: width: 900 }}{% endcapture %}
        {% else %}
          {% capture img %}{{ block.settings.sample | asset_url }}{% endcapture %}
        {% endif %}
        <div {{ block.shopify_attributes }}>
          {% render 'card',
            id: block.id,
            title: block.settings.title,
            price: block.settings.price,
            compare: block.settings.compare,
            blurb: block.settings.blurb,
            image: img,
            badge: block.settings.badge
          %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "vests" },
    { "type": "text", "id": "kicker", "label": "Label", "default": "Vests" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A layer you forget." },
    { "type": "textarea", "id": "copy", "label": "Text", "default": "Merino, thermal and quilted vests." },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "rail", "label": "Row" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "rail"
    },
    { "type": "collection", "id": "collection", "label": "Collection (replaces sample products)" },
    { "type": "range", "id": "limit", "label": "Products from collection", "min": 4, "max": 16, "step": 1, "default": 12 }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "product",
      "name": "Sample product",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Merino Rib Vest" },
        { "type": "number", "id": "price", "label": "Price (Rs)", "default": 2450 },
        { "type": "number", "id": "compare", "label": "Compare at (Rs)", "default": 0 },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Sale" },
        { "type": "textarea", "id": "blurb", "label": "Description", "default": "Fine-gauge merino vest." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select",
          "id": "sample",
          "label": "Sample photo",
          "options": [
            { "value": "vest-ivory.jpg", "label": "Ivory vest" },
            { "value": "vest-charcoal.jpg", "label": "Charcoal vest" },
            { "value": "vest-fog.jpg", "label": "Fog vest" },
            { "value": "vest-ink.jpg", "label": "Ink vest" },
            { "value": "socks-oat.jpg", "label": "Oatmeal socks" },
            { "value": "socks-navy.jpg", "label": "Navy socks" },
            { "value": "socks-stone.jpg", "label": "Stone socks" },
            { "value": "socks-black.jpg", "label": "Black socks" },
            { "value": "boxer-slate.jpg", "label": "Slate trunk" },
            { "value": "boxer-white.jpg", "label": "White brief" },
            { "value": "boxer-charcoal.jpg", "label": "Charcoal brief" },
            { "value": "boxer-sand.jpg", "label": "Sand trunks" }
          ],
          "default": "vest-ivory.jpg"
        }
      ]
    }
  ],
  "presets": [{ "name": "Product section" }]
}
{% endschema %}
